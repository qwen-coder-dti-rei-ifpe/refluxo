    "DJANGO_SETTINGS_MODULE": "config.settings",
    "PYTHON_VERSION": "3.12",
    "POSTGRES_DATABASE": "postgres",
    "POSTGRES_HOST": "aws-0-us-east-1.pooler.supabase.com",
    "POSTGRES_PASSWORD": "Zl6BfAU366Cu9Zoa",
    "POSTGRES_USER": "postgres.xeodkrcoekfsonnwcuag",
    "POSTGRES_PORT": "5432",
    "DATABASE_URL": "postgres://postgres.xeodkrcoekfsonnwcuag:Zl6BfAU366Cu9Zoa@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
  },
  "routes": [
    {
      "src": "/static/(.*)",
