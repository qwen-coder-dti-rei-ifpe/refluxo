{
  "version": 2,
  "framework": null,
  "installCommand": "pip install -r requirements.txt --break-system-packages",
  "buildCommand": "./build_files.sh",
  "outputDirectory": ".vercel/output/static",
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings",
    "PYTHON_VERSION": "3.12"
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": { "cache-control": "s-maxage=31536000,immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py"
    }
  ]
}
