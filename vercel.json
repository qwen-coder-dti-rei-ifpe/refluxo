{
  "version": 2,
  "framework": null,
  "installCommand": "pip install -r requirements.txt --break-system-packages",
  "buildCommand": "cd ifpe_mvp && python manage.py makemigrations --noinput && python manage.py migrate --noinput && python manage.py collectstatic --noinput",
  "outputDirectory": "ifpe_mvp/staticfiles",
  "env": {
    "DJANGO_SETTINGS_MODULE": "ifpe_mvp.config.settings",
    "PYTHON_VERSION": "3.12"
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": { "cache-control": "s-maxage=31536000,immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "ifpe_mvp/config/wsgi.py"
    }
  ],
  "builds": [
    {
      "src": "ifpe_mvp/config/wsgi.py",
      "use": "@vercel/python"
    }
  ]
}
