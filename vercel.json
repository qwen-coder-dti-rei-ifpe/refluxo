{
  "version": 2,
  "framework": null,
  "installCommand": "pip install -r requirements.txt --break-system-packages && python manage.py makemigrations --noinput && python manage.py migrate --noinput && python setup_db.py && python manage.py collectstatic --noinput",
  "outputDirectory": "staticfiles",
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings",
    "PYTHON_VERSION": "3.12",
    "POSTGRES_DATABASE": "postgres",
    "POSTGRES_HOST": "db.xeodkrcoekfsonnwcuag.supabase.co",
    "POSTGRES_PASSWORD": "Zl6BfAU366Cu9Zoa",
    "POSTGRES_USER": "postgres.xeodkrcoekfsonnwcuag",
    "POSTGRES_PORT": "5432"
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": { "cache-control": "s-maxage=31536000,immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py"
    }
  ],
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python"
    }
  ]
}
