```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
*.py.class
*.py.backup
*.swp
*.swo

# Virtual environments
venv/
.venv/
env/
.ENV/

# Django/Python build artifacts
*.class
*.o
*.so
*.a
*.obj
*.out

# Dependencies
node_modules/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
coverage/

# Logs
*.log
*.tmp

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Distribution / packaging
dist/
build/
*.egg-info/
.installed.cfg
*.egg
```