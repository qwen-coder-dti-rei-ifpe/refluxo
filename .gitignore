```gitignore
# Python compiled files
*.pyc
__pycache__/

# Virtual environment
venv/

# Dependencies in virtual environment
venv/lib/python*/site-packages/__pycache__/

# Logs
*.log

# Temporary files
*.tmp
*.swp

# Environment files
.env
.env.local
*.env.*

# IDE and editor files
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Build artifacts
dist/
build/
target/

# MyPy cache
.mypy_cache/

# PyTest cache
.pytest_cache/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```