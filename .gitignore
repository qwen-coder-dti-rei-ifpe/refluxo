```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/

# Dependencies in virtual environment
venv/lib/python*/site-packages/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Coverage reports
coverage/
htmlcov/
.coverage

# Build and distribution
dist/
build/
*.egg-info/

# MyPy cache
.mypy_cache/

# PyTest cache
.pytest_cache/

# Gradle
.gradle/

# Target directory (Maven, Rust, etc.)
target/

# Julia packages
julia-*/

# Zig cache
zig-cache/
zig-out/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```