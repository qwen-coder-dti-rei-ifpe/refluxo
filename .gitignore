```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/

# Dependencies in virtual environment
venv/lib/python*/site-packages/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE specific files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Coverage reports
.coverage
coverage/
htmlcov/

# Database files
*.db
*.sqlite3

# OS generated files
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
target/
*.egg-info/

# Compression files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```